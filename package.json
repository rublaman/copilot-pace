{
  "name": "copilot-pace",
  "displayName": "Copilot Pace",
  "description": "Track GitHub Copilot credits, daily allowance and projected usage in your VS Code status bar.",
  "icon": "images/copilot-pace-128.png",
  "version": "1.1.1",
  "publisher": "rubenblancomanzano",
  "author": "Ruben Blanco Manzano",
  "private": true,
  "preview": false,
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=24 <27"
  },
  "packageManager": "npm@11.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rublaman/copilot-pace.git"
  },
  "bugs": {
    "url": "https://github.com/rublaman/copilot-pace/issues"
  },
  "license": "MIT",
  "categories": [
    "Visualization",
    "AI"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "copilotPace.showDetails",
        "title": "Copilot Pace: Show Details"
      },
      {
        "command": "copilotPace.refresh",
        "title": "Copilot Pace: Refresh Usage"
      },
      {
        "command": "copilotPace.connect",
        "title": "Copilot Pace: Connect GitHub"
      }
    ],
    "configuration": {
      "title": "Copilot Pace",
      "properties": {
        "copilotPace.language": {
          "type": "string",
          "enum": [
            "en",
            "es-ES"
          ],
          "enumDescriptions": [
            "English",
            "Español (España)"
          ],
          "default": "en",
          "scope": "application",
          "description": "Display language for Copilot Pace. Independent of the VS Code display language."
        },
        "copilotPace.dayMode": {
          "type": "string",
          "enum": [
            "all",
            "weekdays"
          ],
          "enumDescriptions": [
            "Every day",
            "Monday to Friday, without a public holiday calendar"
          ],
          "default": "all",
          "scope": "application",
          "description": "Days included in the monthly pace estimate."
        },
        "copilotPace.pollIntervalMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "default": 15,
          "scope": "application",
          "description": "Usage refresh interval, in minutes."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test:unit": "npm run build && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && vscode-test",
    "test:package": "node scripts/smoke.mjs",
    "test": "npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:release",
    "test:release": "node --test test/scripts/*.test.mjs",
    "vscode:prepublish": "npm run build:production",
    "package": "node scripts/package.mjs",
    "package:contents": "npm run build:production && vsce ls",
    "build:production": "node scripts/build.mjs --production"
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.0.5"
    }
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mocha": "11.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
