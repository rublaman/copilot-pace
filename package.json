{
  "name": "copilot-pace",
  "displayName": "Copilot Pace",
  "description": "Track GitHub Copilot credits, daily allowance and projected usage in your VS Code status bar.",
  "icon": "images/copilot-pace-128.png",
  "version": "1.3.6",
  "publisher": "rubenblancomanzano",
  "author": "Ruben Blanco Manzano",
  "private": true,
  "preview": false,
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=24 <27"
  },
  "packageManager": "npm@11.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rublaman/copilot-pace.git"
  },
  "bugs": {
    "url": "https://github.com/rublaman/copilot-pace/issues"
  },
  "license": "MIT",
  "categories": [
    "Visualization",
    "AI"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "copilotPace.showDetails",
        "title": "Copilot Pace: Show Details"
      },
      {
        "command": "copilotPace.refresh",
        "title": "Copilot Pace: Refresh Usage"
      },
      {
        "command": "copilotPace.connect",
        "title": "Copilot Pace: Connect GitHub"
      }
    ],
    "configuration": {
      "title": "Copilot Pace",
      "properties": {
        "copilotPace.authProvider": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "github-enterprise"
          ],
          "enumDescriptions": [
            "Follow Copilot's configured authentication provider (GitHub.com by default)",
            "GitHub.com accounts, including personal and Business plans",
            "The GitHub Enterprise instance configured in VS Code"
          ],
          "default": "auto",
          "scope": "application",
          "description": "Account service used by Copilot Pace. Does not change Copilot's account. Enterprise quota queries require one HTTPS instance origin."
        },
        "copilotPace.language": {
          "type": "string",
          "enum": [
            "en",
            "es-ES"
          ],
          "enumDescriptions": [
            "English",
            "Español (España)"
          ],
          "default": "en",
          "scope": "application",
          "description": "Display language for Copilot Pace. Independent of the VS Code display language."
        },
        "copilotPace.dayMode": {
          "type": "string",
          "enum": [
            "all",
            "weekdays"
          ],
          "enumDescriptions": [
            "Every day",
            "Monday to Friday, without a public holiday calendar"
          ],
          "default": "all",
          "scope": "application",
          "description": "Days included in the monthly pace estimate."
        },
        "copilotPace.pollIntervalMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "default": 15,
          "scope": "application",
          "description": "Usage refresh interval, in minutes."
        },
        "copilotPace.statusStyle": {
          "type": "string",
          "enum": [
            "text",
            "compact",
            "bar",
            "dots"
          ],
          "enumDescriptions": [
            "Used percentage and pace label",
            "Copilot icon and used percentage",
            "Segmented usage bar and percentage",
            "Usage dots and percentage"
          ],
          "default": "text",
          "scope": "application",
          "description": "Appearance of the status bar indicator. Colors continue to follow projected pace; failures remain visible in every style."
        },
        "copilotPace.chartMetric": {
          "type": "string",
          "enum": [
            "cumulative",
            "daily"
          ],
          "enumDescriptions": [
            "Cumulative credits in the current cycle",
            "Credits consumed per UTC day; observed intervals can be partial"
          ],
          "default": "cumulative",
          "scope": "application",
          "description": "Usage metric shown in the history chart. Daily usage is retrieved automatically when available."
        },
        "copilotPace.chartStyle": {
          "type": "string",
          "enum": [
            "line",
            "columns"
          ],
          "enumDescriptions": [
            "Usage line with observed points and gaps",
            "Credits per UTC day, daily or cumulative according to the selected metric"
          ],
          "default": "line",
          "scope": "application",
          "description": "Chart style for daily or cumulative credit usage."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test:unit": "npm run build && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && vscode-test",
    "test:package": "node scripts/smoke.mjs",
    "test": "npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run test:release",
    "test:release": "node --test test/scripts/*.test.mjs",
    "vscode:prepublish": "npm run build:production",
    "package": "node scripts/package.mjs",
    "package:contents": "npm run build:production && vsce ls",
    "build:production": "node scripts/build.mjs --production"
  },
  "overrides": {
    "@azure/identity": {
      "@azure/msal-node": "7.1.1"
    },
    "mocha": {
      "diff": "8.0.3",
      "serialize-javascript": "7.1.3"
    }
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.120.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "mocha": "11.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
