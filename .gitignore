# Installed dependencies
node_modules/

# Extension builds and installable packages
/dist/
/out/
*.vsix
*.tgz

# Downloaded VS Code hosts, test profiles and installed test extensions
# Keep .vscode-test.mjs: it is the shared test runner configuration.
/.vscode-test/

# Test coverage and reports
coverage/
.nyc_output/
lib-cov/
*.lcov

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids/
*.pid
*.pid.lock
*.seed

# Tool caches
.npm/
.cache/
.eslintcache
.stylelintcache
.node_repl_history
*.tsbuildinfo

# Local environment values; keep the shareable example
.env
.env.*
!.env.example

# Local documentation drafts: review before publication.
# Keep the release guide versioned without publishing the other drafts yet.
# Review VSIX documentation separately: vsce always includes README.md by default.
/README.md
/docs/*
!/docs/RELEASING.md

# Personal editor settings; keep shared build/debug configuration
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
!/.vscode/extensions.json
*.code-workspace
.history/
.idea/

# OS metadata and temporary editor files
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
.github/copilot-instructions.md
docs/RELEASING.md
